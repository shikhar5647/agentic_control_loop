{
  "name": "Tennessee Eastman Process (12x12 Control Structure)",
  "description": "The Tennessee Eastman Process is a well-known benchmark chemical process used for testing process control and monitoring strategies. This configuration uses 12 manipulated variables and 12 controlled variables representing key process measurements across the reactor, separator, stripper, and compressor units.",
  "unit_operations": [
    {
      "name": "Reactor",
      "type": "reactor",
      "description": "Main reactor where chemical reactions occur (CVs: y2, y3, y4, y5)"
    },
    {
      "name": "Product Separator",
      "type": "separator",
      "description": "Separates product streams (CVs: y6, y7, y8)"
    },
    {
      "name": "Stripper",
      "type": "stripper",
      "description": "Stripping column for product purification (CVs: y9, y10, y11)"
    },
    {
      "name": "Compressor",
      "type": "compressor",
      "description": "Compresses recycle stream (CVs: y1, y12)"
    }
  ],
